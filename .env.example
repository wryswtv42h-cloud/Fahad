DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
PORT=3000
PUBLIC_SITE_URL=https://your-site.netlify.app
# Comma-separated Discord role IDs. Leave empty to show no public roles.
VISIBLE_ROLE_IDS=
# Account created with this Discord ID becomes OWNER. Change this before public use.
OWNER_DISCORD_ID=w4px
# Discord OAuth2 used to link the website account to the real Discord user.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://your-site.netlify.app/api/platform/discord/callback
# 32+ random characters. Used to encrypt user-supplied bot tokens at rest.
BOT_TOKEN_ENCRYPTION_KEY=
